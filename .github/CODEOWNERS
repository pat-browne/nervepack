# decides which hooks are registered at all
engine/setup/hooks.manifest    @pat-browne
# runs unattended with no human in the loop
**/*cron*    @pat-browne
# CI config; also the only place repo secrets are in scope
.github/workflows/**    @pat-browne
# the PII redaction path
**/np-pii-filter*    @pat-browne
# the secret/PII publication gate
**/np-publish-scan*    @pat-browne
# layer path resolution; a wrong root reads or writes the wrong repo
**/np_content.py    @pat-browne
# installers mutate the machine outside the repo
engine/setup/*install*    @pat-browne
# reads and stores credentials
**/np_token*    @pat-browne
