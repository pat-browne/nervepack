{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash",
          "merge",
          "rebase"
        ],
        "require_extra_approval_for_unattributed_changes": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Syntax sweep (stdlib-only)"
          },
          {
            "context": "Regression suite (zero-dep)"
          },
          {
            "context": "Secret/PII guard (terminal gate)"
          },
          {
            "context": "Windows suite (Git-bash)"
          },
          {
            "context": "Bash-free MCP suite (no Git-bash)"
          },
          {
            "context": "Spec guard (change-specs)"
          }
        ]
      }
    }
  ]
}
